{% extends 'base.html.twig' %}

{% block title %}Location{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">Location</h1>

        <table class="table table-bordered table-striped">
            <tbody>
            <tr>
                <th style="width: 200px;">Id</th>
                <td>{{ location.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ location.name }}</td>
            </tr>
            <tr>
                <th>Country</th>
                <td>{{ location.country }}</td>
            </tr>
            <tr>
                <th>Geo_width</th>
                <td>{{ location.geoWidth }}</td>
            </tr>
            <tr>
                <th>Geo_lenght</th>
                <td>{{ location.geoLenght }}</td>
            </tr>
            </tbody>
        </table>

        <!-- Kontener z przyciskami w jednej linii -->
        <div class="d-flex gap-2 align-items-center mt-3">
            <a href="{{ path('app_location_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to list
            </a>

            <a href="{{ path('app_location_edit', {'id': location.id}) }}" class="btn btn-warning">
                <i class="bi bi-pencil"></i> Edit
            </a>

            <!-- Formularz usuwania -->
            {{ include('location/_delete_form.html.twig') }}
        </div>
    </div>
{% endblock %}
<!-- Wygenerowane przez gemini -->
