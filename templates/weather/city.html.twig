{% extends 'base.html.twig' %}

{# @var location \App\Entity\Location #}
{# @var forecasts \App\Entity\Forecast[] #}

{% block title %}Weather in {{ location.name }}, {{ location.country }}{% endblock %}

{% block body %}
    <main>
        <h1>Weather in {{ location.name }}, {{ location.country }}</h1>
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Date</th>
                <th>Temperature</th>
                <th>Humidity</th>
                <th>Wind speed</th>
                <th>Precipitation</th>
            </tr>
            </thead>
            <tbody>
            {% for forecast in forecasts %}
                <tr>
                    <td>{{ forecast.date|date('d.m.Y') }}</td>
                    <td>{{ forecast.tempCelc }}&deg;C</td>
                    <td>{{ forecast.humidity }}%</td>
                    <td>{{ forecast.windSpeed }} km/h</td>
                    <td>{{ forecast.precipitation }} mm</td>
                </tr>
            {% else %}
                <tr><td colspan="5">Brak prognoz</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </main>
    <!-- Wygenerowane z pomoca claude 5.5 opus -->
{% endblock %}
